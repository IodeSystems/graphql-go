#!/usr/bin/env bash
#
# bin/perf — compare benchmark performance between two git refs.
#
# Runs every benchmark in the repo by default. The benchmark list is
# discovered from the refs themselves, not hardcoded: anything that does
# not match a known group still runs, under an "other" group. A newly
# added benchmark is therefore picked up automatically rather than being
# silently left out of the comparison.
#
# Uses git worktrees, so the working tree is never touched and comparing
# two commits needs no stashing.
#
# Usage:
#   bin/perf                        # upstream/master vs HEAD, updates README
#   bin/perf <ref>                  # <ref> vs the working tree (even if dirty)
#   bin/perf <ref-a> <ref-b>        # two explicit refs
#   bin/perf --list                 # show every benchmark and its group; run nothing
#
# Targeting (default: every group):
#   --only <group>[,<group>...]     restrict to named groups (see --list)
#   --bench <regex>                 arbitrary benchmark regex; implies --no-readme
#
# Run control:
#   --count <n>                     samples per benchmark (default: 6)
#   --benchtime <t>                 per-sample budget (default: 2s)
#   --quick                         count=1, benchtime=10x; implies --no-readme
#   --wait                          block until the machine is quiet, then run
#   --force                         run even when the machine looks busy
#
# Output:
#   --no-readme                     print to stdout instead of updating README
#
# Environment:
#   PERF_COUNT / PERF_BENCHTIME     defaults for --count / --benchtime
#
# Requires: go, git, benchstat (auto-installed if missing).

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

err() { echo "perf: $*" >&2; }
die() { err "$*"; exit 2; }

# ---------------------------------------------------------------- groups
#
# name :: package :: benchmark regex
#
# Grouping is presentation only — it decides which benchmarks share a
# table. Coverage does not depend on it: whatever these patterns miss is
# collected into an "other-<pkg>" group and run anyway.
GROUP_DEFS=(
    "parse::./language/parser/::^BenchmarkParse_"
    "print::./language/printer/::^BenchmarkPrint"
    "plan::./::^BenchmarkPlanned|^BenchmarkPlanCache|^BenchmarkPlanQuery"
    "execute::./::^BenchmarkUncachedExecute|^BenchmarkWideQuery|^BenchmarkListQuery"
)
PACKAGES=("./" "./language/parser/" "./language/printer/")

# ----------------------------------------------------------------- args
ONLY=""; BENCH_RE=""
UPDATE_README=1; DO_LIST=0; FORCE=0; WAIT_QUIET=0
COUNT="${PERF_COUNT:-6}"
BENCHTIME="${PERF_BENCHTIME:-2s}"
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        --list)       DO_LIST=1 ;;
        --no-readme)  UPDATE_README=0 ;;
        --force)      FORCE=1 ;;
        --wait)       WAIT_QUIET=1 ;;
        --quick)      COUNT=1; BENCHTIME=10x; UPDATE_README=0 ;;
        --only)       [ $# -ge 2 ] || die "--only needs a value"; ONLY=$2; shift ;;
        --bench)      [ $# -ge 2 ] || die "--bench needs a value"; BENCH_RE=$2; UPDATE_README=0; shift ;;
        --count)      [ $# -ge 2 ] || die "--count needs a value"; COUNT=$2; shift ;;
        --benchtime)  [ $# -ge 2 ] || die "--benchtime needs a value"; BENCHTIME=$2; shift ;;
        -h|--help)    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
        --*)          die "unknown option $1 — see bin/perf --help" ;;
        *)            POSITIONAL+=("$1") ;;
    esac
    shift
done

REF_A=""; REF_B=""
case ${#POSITIONAL[@]} in
    0) REF_A="upstream/master"; REF_B="HEAD" ;;
    1) REF_A="${POSITIONAL[0]}"; REF_B="." ;;
    2) REF_A="${POSITIONAL[0]}"; REF_B="${POSITIONAL[1]}" ;;
    *) die "expected at most two refs, got ${#POSITIONAL[@]}" ;;
esac

# --------------------------------------------------------- busy machine
#
# Numbers from a loaded machine are worse than no numbers: they look
# authoritative and are wrong. Both guards yield to --force.
#
# The lock matters most — it makes two concurrent bin/perf runs (from
# another shell, or another agent session) impossible rather than merely
# unlikely.
# A PID file rather than flock. flock holds the lock through a file
# descriptor, and children inherit open descriptors — so any long-lived
# process a stage spawns keeps the lock after this script exits, locking
# out every later run. That bit the sibling tool in gwag, whose stages
# daemonize backends. The stages here only run `go test`, which exits,
# but the failure mode is silent and permanent when it does happen, so
# use the mechanism that cannot exhibit it.
LOCKFILE="${TMPDIR:-/tmp}/graphql-go-perf.pid"
if [ -f "$LOCKFILE" ]; then
    other=$(cat "$LOCKFILE" 2>/dev/null || echo "")
    if [ -n "$other" ] && [ "$other" != "$$" ] && kill -0 "$other" 2>/dev/null; then
        if [ "$FORCE" = "1" ]; then
            err "bin/perf may already be running as pid $other; continuing (--force)"
        else
            die "another bin/perf is running (pid $other, $LOCKFILE). Wait for it, or --force."
        fi
    elif [ -n "$other" ]; then
        err "clearing stale lock from pid $other"
    fi
fi
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT

if [ "$DO_LIST" = "0" ] && [ "$FORCE" = "0" ]; then
    cores=$(nproc 2>/dev/null || echo 4)
    busy() { awk -v l="$(cut -d' ' -f1 /proc/loadavg)" -v c="$cores" 'BEGIN{exit !(l > c/4)}'; }
    if busy; then
        if [ "$WAIT_QUIET" = "1" ]; then
            # Load average decays over minutes, so a run that just finished
            # leaves the box reading busy well after it is idle. Comparing
            # two refs back to back needs to wait, not fail or force.
            err "machine busy (load $(cut -d' ' -f1 /proc/loadavg) on $cores cores) — waiting to settle"
            waited=0
            while busy && [ "$waited" -lt 900 ]; do sleep 15; waited=$((waited + 15)); done
            busy && die "still busy after ${waited}s (load $(cut -d' ' -f1 /proc/loadavg)). Giving up."
            err "settled after ${waited}s"
        else
            err "machine looks busy: 1-min load $(cut -d' ' -f1 /proc/loadavg) on ${cores} cores."
            err "Benchmarking now produces numbers you cannot trust."
            die "Wait for it to settle, pass --wait to block until quiet, or --force."
        fi
    fi
fi

# ------------------------------------------------------------ resolving
resolve() { git rev-parse --verify --quiet "$1^{commit}" 2>/dev/null || true; }

USE_DIR_B=0
SHA_A=$(resolve "$REF_A"); [ -n "$SHA_A" ] || die "unknown ref: $REF_A"
SHORT_A=$(git rev-parse --short "$SHA_A")
if [ "$REF_B" = "." ]; then
    USE_DIR_B=1; SHORT_B="dirty"; SHA_B=$(git rev-parse HEAD)
else
    SHA_B=$(resolve "$REF_B"); [ -n "$SHA_B" ] || die "unknown ref: $REF_B"
    SHORT_B=$(git rev-parse --short "$SHA_B")
fi

if ! command -v benchstat >/dev/null; then
    err "installing benchstat..."
    go install golang.org/x/perf/cmd/benchstat@latest
fi
command -v benchstat >/dev/null || die "benchstat not on PATH after install"

TMP=$(mktemp -d)
WT_A="$TMP/wt-a"; WT_B="$TMP/wt-b"
cleanup() {
    git worktree remove --force "$WT_A" >/dev/null 2>&1 || true
    if [ "$USE_DIR_B" = "0" ]; then
        git worktree remove --force "$WT_B" >/dev/null 2>&1 || true
    fi
    rm -rf "$TMP"
}
trap cleanup EXIT

err "preparing worktrees..."
git worktree add --detach "$WT_A" "$SHA_A" >/dev/null
if [ "$USE_DIR_B" = "0" ]; then
    git worktree add --detach "$WT_B" "$SHA_B" >/dev/null
else
    WT_B="$REPO_ROOT"
fi

MOD_A=$(head -1 "$WT_A/go.mod" | awk '{print $2}')
MOD_B=$(head -1 "$WT_B/go.mod" | awk '{print $2}')

# ------------------------------------------------- cross-ref bench files
#
# Upstream has no parser benchmarks, so without this the parse comparison
# degrades to one populated column and the headline parser numbers vanish
# from the README. The parser package's API is identical across the two
# refs, so the benchmark file compiles on either side once its import path
# is rewritten.
#
# Deliberately parse-only. plan_bench_test.go exists in BOTH refs with
# different contents — this fork's version calls ExecutePlanAppend, which
# upstream does not have, so copying it across would fail to compile.
# Widening this to "any *_bench_test.go" would break the plan group.
PARSE_BENCH="language/parser/parser_bench_test.go"
if [ -f "$WT_A/$PARSE_BENCH" ] && [ ! -f "$WT_B/$PARSE_BENCH" ]; then
    sed "s|$MOD_A|$MOD_B|g" "$WT_A/$PARSE_BENCH" > "$WT_B/$PARSE_BENCH"
    err "copied $PARSE_BENCH into $SHORT_B (module rewrite)"
elif [ -f "$WT_B/$PARSE_BENCH" ] && [ ! -f "$WT_A/$PARSE_BENCH" ]; then
    sed "s|$MOD_B|$MOD_A|g" "$WT_B/$PARSE_BENCH" > "$WT_A/$PARSE_BENCH"
    err "copied $PARSE_BENCH into $SHORT_A (module rewrite)"
fi

# ----------------------------------------------------------- discovery
discover() { # <worktree> <pkg> -> benchmark names
    (cd "$1" && go test -list='^Benchmark' "$2" 2>/dev/null) | grep -E '^Benchmark' || true
}

err "discovering benchmarks..."
declare -A HAVE_A HAVE_B GROUP_OF
ALL_KEYS=()
for pkg in "${PACKAGES[@]}"; do
    names=$( { discover "$WT_A" "$pkg"; discover "$WT_B" "$pkg"; } | sort -u )
    [ -n "$names" ] || continue
    while read -r b; do
        [ -n "$b" ] || continue
        ALL_KEYS+=("$pkg|$b")
    done <<<"$names"
    while read -r b; do [ -n "$b" ] && HAVE_A["$pkg|$b"]=1; done < <(discover "$WT_A" "$pkg")
    while read -r b; do [ -n "$b" ] && HAVE_B["$pkg|$b"]=1; done < <(discover "$WT_B" "$pkg")
done
[ ${#ALL_KEYS[@]} -gt 0 ] || die "no benchmarks found in either ref"

# Assign each benchmark to a group. Unmatched -> other-<pkg>.
GROUP_ORDER=()
declare -A GROUP_PKG GROUP_LIST
note_group() { # <name> <pkg>
    if [ -z "${GROUP_PKG[$1]:-}" ]; then GROUP_ORDER+=("$1"); GROUP_PKG[$1]=$2; fi
}
pkg_slug() { # ./language/parser/ -> language-parser ; ./ -> root
    local p=${1#./}; p=${p%/}
    [ -z "$p" ] && { echo root; return; }
    echo "${p//\//-}"
}
for key in "${ALL_KEYS[@]}"; do
    pkg=${key%%|*}; name=${key#*|}
    g=""
    for def in "${GROUP_DEFS[@]}"; do
        dn=${def%%::*}; rest=${def#*::}; dpkg=${rest%%::*}; dpat=${rest#*::}
        [ "$dpkg" = "$pkg" ] || continue
        if grep -qE "$dpat" <<<"$name"; then g=$dn; break; fi
    done
    [ -n "$g" ] || g="other-$(pkg_slug "$pkg")"
    note_group "$g" "$pkg"
    GROUP_OF[$key]=$g
    GROUP_LIST[$g]+="$name "
done

# Stable, readable member list for a group.
group_members() { tr ' ' '\n' <<<"${GROUP_LIST[$1]}" | grep -v '^$' | sort; }

# ---------------------------------------------------------------- --list
if [ "$DO_LIST" = "1" ]; then
    total=0
    printf 'Benchmarks in %s (%s) and %s (%s)\n\n' "$REF_A" "$SHORT_A" "$REF_B" "$SHORT_B"
    for g in "${GROUP_ORDER[@]}"; do
        n=$(group_members "$g" | wc -l)
        total=$((total + n))
        printf '  %-16s %-22s %d benchmark(s)\n' "$g" "${GROUP_PKG[$g]}" "$n"
        while read -r b; do
            [ -n "$b" ] || continue
            key="${GROUP_PKG[$g]}|$b"
            mark="both "
            [ -n "${HAVE_A[$key]:-}" ] && [ -z "${HAVE_B[$key]:-}" ] && mark="$SHORT_A only"
            [ -z "${HAVE_A[$key]:-}" ] && [ -n "${HAVE_B[$key]:-}" ] && mark="$SHORT_B only"
            printf '      %-52s %s\n' "$b" "$mark"
        done < <(group_members "$g")
        echo
    done
    printf 'Total: %d benchmarks across %d group(s). All are run by default.\n' \
        "$total" "${#GROUP_ORDER[@]}"
    for g in "${GROUP_ORDER[@]}"; do
        case "$g" in other-*)
            printf 'Note: %s holds benchmarks matching no group pattern. They still run;\n' "$g"
            printf '      add a pattern to GROUP_DEFS in bin/perf to give them their own table.\n' ;;
        esac
    done
    exit 0
fi

# ------------------------------------------------------------- selection
SELECTED=()
if [ -n "$BENCH_RE" ]; then
    # Ad-hoc regex: one table per package that has a match.
    for pkg in "${PACKAGES[@]}"; do
        hits=""
        for key in "${ALL_KEYS[@]}"; do
            [ "${key%%|*}" = "$pkg" ] || continue
            name=${key#*|}
            grep -qE "$BENCH_RE" <<<"$name" && hits+="$name "
        done
        [ -n "$hits" ] || continue
        g="match-$(pkg_slug "$pkg")"
        GROUP_ORDER+=("$g"); GROUP_PKG[$g]=$pkg; GROUP_LIST[$g]=$hits
        SELECTED+=("$g")
    done
    [ ${#SELECTED[@]} -gt 0 ] || die "no benchmark matches regex: $BENCH_RE"
elif [ -n "$ONLY" ]; then
    IFS=',' read -ra want <<<"$ONLY"
    for w in "${want[@]}"; do
        found=0
        for g in "${GROUP_ORDER[@]}"; do [ "$g" = "$w" ] && { SELECTED+=("$g"); found=1; }; done
        [ "$found" = "1" ] || die "unknown group '$w' — see bin/perf --list"
    done
else
    SELECTED=("${GROUP_ORDER[@]}")
fi

SKIPPED=()
for g in "${GROUP_ORDER[@]}"; do
    case "$g" in match-*) continue ;; esac
    keep=0
    for s in "${SELECTED[@]}"; do [ "$s" = "$g" ] && keep=1; done
    [ "$keep" = "1" ] || SKIPPED+=("$g")
done

# ---------------------------------------------------------------- running
# Rewrites the "pkg:" line so benchstat can pair results across forks
# whose module paths differ. Strips the ref's own module prefix rather
# than keeping the last path segment: the fork and upstream module names
# differ in their final segment (graphql-go vs graphql), and a
# last-segment rule leaves the root package labelled differently on each
# side, which makes benchstat refuse to pair them.
normalize_pkg() { # <file> <module>
    sed -i -E "s|^pkg: ${2}/|pkg: |; s|^pkg: ${2}\$|pkg: root|" "$1"
}

run_bench() { # <worktree> <pattern> <pkg> <out>
    (cd "$1" && go test -run='^$' -bench="$2" -benchtime="$BENCHTIME" -count="$COUNT" "$3" 2>/dev/null) > "$4"
}

declare -A OUT_A OUT_B
for g in "${SELECTED[@]}"; do
    pkg=${GROUP_PKG[$g]}
    pat="^($(group_members "$g" | paste -sd'|' -))\$"
    OUT_A[$g]="$TMP/${SHORT_A}-${g}.txt"
    OUT_B[$g]="$TMP/${SHORT_B}-${g}.txt"
    err "==> $g ($(group_members "$g" | wc -l) benchmarks in $pkg)"
    err "    $SHORT_A"; run_bench "$WT_A" "$pat" "$pkg" "${OUT_A[$g]}"
    err "    $SHORT_B"; run_bench "$WT_B" "$pat" "$pkg" "${OUT_B[$g]}"
    normalize_pkg "${OUT_A[$g]}" "$MOD_A"
    normalize_pkg "${OUT_B[$g]}" "$MOD_B"
done

# -------------------------------------------------------------- render
summary_table() {
    local title=$1; shift
    local labels=() files=()
    while [ $# -ge 2 ]; do labels+=("$1"); files+=("$2"); shift 2; done
    local dir; dir=$(dirname "${files[0]}")
    local basenames=(); local f
    for f in "${files[@]}"; do basenames+=("$(basename "$f")"); done

    (cd "$dir" && benchstat -format csv "${basenames[@]}" 2>/dev/null) | \
    awk -v title="$title" -v labels_str="${labels[*]}" '
        BEGIN { FS=","; n_labels = split(labels_str, lbl, " ") }
        function fmt(s,    v) {
            v = s + 0
            if (v == 0) return s
            if (v < 1e-6) return sprintf("%.0fns", v*1e9)
            if (v < 1e-3) return sprintf("%.2fµs", v*1e6)
            if (v < 1)    return sprintf("%.2fms", v*1000)
            return sprintf("%.2fs", v)
        }
        function fmt_mult(m) {
            if (m >= 100) return sprintf("%.0fx", m)
            if (m >= 10)  return sprintf("%.1fx", m)
            return sprintf("%.2fx", m)
        }
        # benchstat "vs base" percent -> the same multiplier fmt_mult wants.
        # Used for geomean: each column geomean covers only the benchmarks
        # in that column, so when a ref lacks some, dividing the two column
        # geomeans compares different sets. benchstat computes its delta
        # over the paired subset, which is the honest number.
        function mult_from_delta(d,    p) {
            gsub(/%/, "", d); p = d + 0
            if (p <= -100) return 0
            return 100 / (100 + p)
        }
        $2 == "sec/op" { in_section = 1; next }
        $2 == "B/op" || $2 == "allocs/op" { in_section = 0; next }
        /^,/ { next }
        in_section && $1 != "" {
            is_geo = ($1 == "geomean")
            if (!printed) {
                print "**" title " — sec/op (× = base/val; >1× faster)**"
                print ""
                row = "| Benchmark"; sep = "|---"
                for (i = 1; i <= n_labels; i++) { row = row " | " lbl[i]; sep = sep "|---:" }
                print row " |"; print sep "|"
                printed = 1
            }
            row = is_geo ? "| **" $1 "**" : "| " $1
            base_val = $2 + 0
            for (i = 1; i <= n_labels; i++) {
                if (i == 1) {
                    cell = (base_val == 0) ? fmt($2) : fmt($2) " (1.00x)"
                } else {
                    vfield = 4 * i - 4; dfield = 4 * i - 2
                    delta = $dfield; val = $vfield + 0
                    if (val == 0 || base_val == 0) { cell = fmt($vfield); unpaired = 1 }
                    else if (delta == "" || delta == "~") { cell = fmt($vfield) " (~)" }
                    else if (is_geo) { cell = fmt($vfield) " (" fmt_mult(mult_from_delta(delta)) ")" }
                    else { cell = fmt($vfield) " (" fmt_mult(base_val / val) ")" }
                }
                if (is_geo) cell = "**" cell "**"
                row = row " | " cell
            }
            print row " |"
        }
        END {
            if (unpaired) {
                print ""
                print "_Blank cells: benchmark absent from that ref. The geomean × is benchstat'"'"'s, computed over the benchmarks present in both; each column'"'"'s geomean value covers only its own rows._"
            }
        }
    '
}

emit_section() { # <title> <labelA> <fileA> <labelB> <fileB>
    local title=$1; shift
    local labels=() files=()
    while [ $# -ge 2 ]; do labels+=("$1"); files+=("$2"); shift 2; done
    local f
    for f in "${files[@]}"; do
        if [ ! -s "$f" ]; then
            printf '**%s**\n\n_Not run: no results._\n\n' "$title"; return
        fi
    done
    local args=(); local i
    for ((i=0; i<${#labels[@]}; i++)); do args+=("${labels[$i]}" "${files[$i]}"); done
    summary_table "$title" "${args[@]}"
    local dir; dir=$(dirname "${files[0]}")
    local basenames=()
    for f in "${files[@]}"; do basenames+=("$(basename "$f")"); done
    printf '\n<details>\n<summary>Full benchstat output</summary>\n\n```\n'
    (cd "$dir" && benchstat "${basenames[@]}" 2>/dev/null)
    printf '```\n\n</details>\n\n'
}

DATE=$(date -u +%Y-%m-%d)
if [ "$USE_DIR_B" = "1" ]; then
    CMP_B=$(git rev-parse HEAD); CMP_NOTE=" (counts are HEAD's; B also has uncommitted changes)"
else
    CMP_B="$SHA_B"; CMP_NOTE=""
fi
AHEAD=$(git rev-list --count "$SHA_A".."$CMP_B")
BEHIND=$(git rev-list --count "$CMP_B".."$SHA_A")
RAN_COUNT=0
for g in "${SELECTED[@]}"; do RAN_COUNT=$((RAN_COUNT + $(group_members "$g" | wc -l))); done

TABLE=$(mktemp)
{
    printf '_Generated by `bin/perf` on %s. A=`%s` (%s), B=`%s` (%s). B is %s commits ahead of A, %s behind%s. count=%s, benchtime=%s._\n\n' \
        "$DATE" "$REF_A" "$SHORT_A" "$REF_B" "$SHORT_B" "$AHEAD" "$BEHIND" "$CMP_NOTE" "$COUNT" "$BENCHTIME"
    printf '_%d benchmarks across %d group(s)' "$RAN_COUNT" "${#SELECTED[@]}"
    if [ ${#SKIPPED[@]} -gt 0 ]; then
        printf '; skipped by --only: %s' "$(printf '%s ' "${SKIPPED[@]}" | sed 's/ $//')"
    fi
    printf '._\n\n'
    for g in "${SELECTED[@]}"; do
        emit_section "$g" "$SHORT_A" "${OUT_A[$g]}" "$SHORT_B" "${OUT_B[$g]}"
    done
} > "$TABLE"

if [ "$UPDATE_README" = "0" ]; then cat "$TABLE"; exit 0; fi

README="$REPO_ROOT/README.md"
START="<!-- perf-start -->"; END="<!-- perf-end -->"
if [ ! -f "$README" ]; then err "README.md not found; printing"; cat "$TABLE"; exit 0; fi
if grep -q "$START" "$README" && grep -q "$END" "$README"; then
    awk -v start="$START" -v end="$END" -v table_file="$TABLE" '
        index($0, start) { print; while ((getline line < table_file) > 0) print line; in_section = 1; next }
        index($0, end)   { in_section = 0; print; next }
        !in_section { print }
    ' "$README" > "$README.tmp"
    mv "$README.tmp" "$README"
    err "updated README.md between markers"
else
    die "no perf markers in README.md; add $START / $END, or use --no-readme"
fi
